{
  "manifest_version": 3,
  "name": "LinkedIn Focus \u2014 Local Prototype",
  "version": "0.1.2",
  "description": "Filter feed posts with editable keywords and local feedback learning. No server or API key.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "model.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Focus"
  }
}